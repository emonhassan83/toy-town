# ==========================================
# Toy Town - Monorepo .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env
client/.env
client/.env.local
server/.env
server/_user_credintial.txt

# Production Build Outputs
dist/
client/dist/
server/dist/
build/
out/

# Vite & Bundler Caches
.vite/
client/.vite/
*.tsbuildinfo
.eslintcache
.stylelintcache

# Hosting & Serverless Metadata
.vercel/
client/.vercel/
server/.vercel/
.firebase/
client/.firebase/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
*.lcov
.nyc_output

# OS & IDE Metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Scratch & Temporary Files
scratch/
tmp/
temp/
